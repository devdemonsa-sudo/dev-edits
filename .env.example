NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to encrypt API secrets before saving them in Supabase.
INTEGRATION_TOKEN_SECRET=change-me-to-a-long-random-secret

# Optional protection for the cron route.
CRON_SECRET=change-me-to-a-second-long-random-secret

# Optional public URL.
NEXT_PUBLIC_APP_URL=https://repassecheck.vercel.app

# Optional external providers. Leave empty to keep the free local fallback.
ANTHROPIC_API_KEY=
WHISK_API_URL=
WHISK_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
